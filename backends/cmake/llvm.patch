Backport of https://github.com/llvm/llvm-project/pull/240805 (5f93c6a7) without
tests: AVX2 hosts without AVX512BW+VL failed to select bf16 broadcasts.
Remove when the pinned LLVM revision includes it.

diff --git a/llvm/lib/Target/X86/X86ISelLowering.cpp b/llvm/lib/Target/X86/X86ISelLowering.cpp
index 238250a8b67a..d113e8c416f6 100644
--- a/llvm/lib/Target/X86/X86ISelLowering.cpp
+++ b/llvm/lib/Target/X86/X86ISelLowering.cpp
@@ -43633,7 +43633,10 @@ static SDValue combineTargetShuffle(SDValue N, const SDLoc &DL,
             BCVT.getScalarType().getTypeForEVT(*DAG.getContext()))) {
       EVT NewVT = EVT::getVectorVT(*DAG.getContext(), BCVT.getScalarType(),
                                    VT.getVectorNumElements());
-      return DAG.getBitcast(VT, DAG.getNode(X86ISD::VBROADCAST, DL, NewVT, BC));
+      // NewVT can be illegal even if BCVT is legal (e.g. v16bf16 vs. v8bf16).
+      if (TLI.isTypeLegal(NewVT))
+        return DAG.getBitcast(VT,
+                              DAG.getNode(X86ISD::VBROADCAST, DL, NewVT, BC));
     }
 
     // vbroadcast(bitcast(vbroadcast(src))) -> bitcast(vbroadcast(src))
@@ -43648,7 +43651,9 @@ static SDValue combineTargetShuffle(SDValue N, const SDLoc &DL,
       MVT NewVT =
           MVT::getVectorVT(BCVT.getSimpleVT().getScalarType(),
                            VT.getSizeInBits() / BCVT.getScalarSizeInBits());
-      return DAG.getBitcast(VT, DAG.getNode(X86ISD::VBROADCAST, DL, NewVT, BC));
+      if (TLI.isTypeLegal(NewVT))
+        return DAG.getBitcast(VT,
+                              DAG.getNode(X86ISD::VBROADCAST, DL, NewVT, BC));
     }
 
     // Reduce broadcast source vector to lowest 128-bits.
diff --git a/llvm/lib/Target/X86/X86InstrSSE.td b/llvm/lib/Target/X86/X86InstrSSE.td
index 95426695f7b2..00b393376a40 100644
--- a/llvm/lib/Target/X86/X86InstrSSE.td
+++ b/llvm/lib/Target/X86/X86InstrSSE.td
@@ -7852,6 +7852,17 @@ let Predicates = [HasAVX2, NoVLX_Or_NoBWI] in {
             (VPBROADCASTWrr (COPY_TO_REGCLASS FR16:$src, VR128))>;
   def : Pat<(v16f16 (X86VBroadcast (f16 FR16:$src))),
             (VPBROADCASTWYrr (COPY_TO_REGCLASS FR16:$src, VR128))>;
+
+  // No scalar bf16 broadcast patterns: scalar bf16 is not a legal type.
+  def : Pat<(v8bf16 (X86VBroadcastld16 addr:$src)),
+            (VPBROADCASTWrm addr:$src)>;
+  def : Pat<(v16bf16 (X86VBroadcastld16 addr:$src)),
+            (VPBROADCASTWYrm addr:$src)>;
+
+  def : Pat<(v8bf16 (X86VBroadcast (v8bf16 VR128:$src))),
+            (VPBROADCASTWrr VR128:$src)>;
+  def : Pat<(v16bf16 (X86VBroadcast (v8bf16 VR128:$src))),
+            (VPBROADCASTWYrr VR128:$src)>;
 }
 let Predicates = [HasAVX2, NoVLX] in {
   def : Pat<(v4i32 (X86VBroadcast GR32:$src)),
